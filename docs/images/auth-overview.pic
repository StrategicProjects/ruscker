# Two ways a system learns who the user is.
# One account base (accounts, groups, 2FA) in Ruscker; a hosted app behind the
# proxy receives identity HEADERS, an external system receives an ID TOKEN.
# Render: rpic --prelude theme=<skill>/assets/editorial-light.pic --svg -o auth-overview.svg auth-overview.pic

# Ruscker palette over the editorial theme.
paper  = 0xffffff
paper2 = 0xf1f8f5
ink    = 0x085041
muted  = 0x3d6b5f
soft   = 0x3d6b5f
rule   = 0xb9d6cc
accent = 0x0f6e56
accenttint = 0xe1f5ee
margin = 0.15

# A white page behind everything, so the figure reads on dark site themes.
Bg: box wid 11.3 ht 2.75 rad 0.1 shaded paper outlined paper at (4.55, -0.1)

U: node("User" "browser" mono small, wid 1.5 at (0, 0))
R: focal("Ruscker" "accounts · groups · 2FA" mono small, wid 2.3 ht 0.7 at U + (3.6, 0))
H: node("Hosted app" "behind /app/{id}" mono small, wid 2.1 at R + (4.7, 0.75))
X: node("External system" "another host or domain" mono small, wid 2.1 at R + (4.7, -0.75))

flow(U.e, R.w, "signs in once")
# Off-axis: one elbow each, leaving Ruscker from distinct points. The
# label sits on the long horizontal run into each node.
ex = R.e.x + 0.35
arrow from R.e + (0, 0.15) to (ex, R.e.y + 0.15) then to (ex, H.w.y) then to H.w outlined muted
arrow from R.e + (0, -0.15) to (ex, R.e.y - 0.15) then to (ex, X.w.y) then to X.w outlined accent thick 1.4
"identity headers" mono small shaded soft above at (0.5 between (ex, H.w.y) and H.w) + (0, 0.02)
"ID token · OpenID Connect" mono small shaded ink above at (0.5 between (ex, X.w.y) and X.w) + (0, 0.02)

"per request, added by the proxy" italic small shaded muted at H.s + (0, -0.16)
"once per sign-in, verified by the system" italic small shaded muted at X.s + (0, -0.16)
