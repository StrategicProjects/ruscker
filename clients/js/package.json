{
  "name": "ruscker-sso",
  "version": "0.1.0",
  "private": true,
  "description": "Sign people in through a Ruscker portal (OpenID Connect): a dependency-free browser half and a Node backend half.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test build-test/test/unit.test.js",
    "test:e2e": "npm run build:test && node --test build-test/test/e2e.test.js",
    "test:all": "npm run build:test && node --test 'build-test/test/*.test.js'"
  },
  "dependencies": {
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
