# "Sign in with Ruscker" — the OpenID Connect authorization-code flow with PKCE.
# Three actors: the external system (its server), the user's browser, Ruscker.
# Everything goes through the browser except the code-for-token exchange,
# which the system's server makes directly — the one arrow that crosses
# the browser's lifeline.
# Render: rpic --prelude theme=<skill>/assets/editorial-light.pic --svg -o auth-flow.svg auth-flow.pic

# Ruscker palette over the editorial theme.
paper  = 0xffffff
paper2 = 0xf1f8f5
ink    = 0x085041
muted  = 0x3d6b5f
soft   = 0x3d6b5f
rule   = 0xb9d6cc
accent = 0x0f6e56
accenttint = 0xe1f5ee
margin = 0.15

# A white page behind everything, so the figure reads on dark site themes.
Bg: box wid 8.3 ht 5.3 rad 0.1 shaded paper outlined paper at (3.1, -2.12)

# Actors.
S: node("External system" "its server" mono small, wid 1.7 at (0, 0))
B: node("Browser" "the user" mono small, wid 1.7 at S + (3.1, 0))
R: focal("Ruscker" "OIDC provider" mono small, wid 1.7 at B + (3.1, 0))

# Lifelines.
define life { line from $1.s down 4.15 outlined rule dashed 0.06 }
life(S); life(B); life(R)

# Ruscker is busy from the authorization request to the token response.
Act: box wid 0.12 ht 2.95 with .n at R.s + (0, -0.95) outlined accent shaded accenttint

# Messages: msg(FROM.x, TO.x, y, "label"); hot = the step that carries the secret.
define msg { arrow from ($1, $3) to ($2, $3) outlined muted; $4 mono small shaded soft above at (0.5 between ($1, $3) and ($2, $3)) + (0, 0.04) }
define ret { arrow from ($1, $3) to ($2, $3) outlined muted dashed 0.05; $4 mono small shaded soft above at (0.5 between ($1, $3) and ($2, $3)) + (0, 0.04) }
define hot { arrow from ($1, $3) to ($2, $3) outlined accent thick 1.4; $4 mono small shaded ink above at (0.25 between ($1, $3) and ($2, $3)) + (0, 0.04) }
define hotret { arrow from ($1, $3) to ($2, $3) outlined accent thick 1.4 dashed 0.05; $4 mono small shaded ink above at (0.25 between ($1, $3) and ($2, $3)) + (0, 0.04) }

y0 = S.s.y
msg(B.x, S.x, y0 - 0.45, "1  open the system")
ret(S.x, B.x, y0 - 0.95, "2  redirect to Ruscker")
msg(B.x, R.x - 0.06, y0 - 0.95, "/oauth/authorize + PKCE challenge")
ret(R.x - 0.06, B.x, y0 - 1.55, "3  sign in · groups · MFA")
ret(R.x - 0.06, B.x, y0 - 2.15, "4  redirect back with a one-use code")
msg(B.x, S.x, y0 - 2.15, "code")
hot(S.x, R.x - 0.06, y0 - 2.95, "5  POST /oauth/token  ·  secret + code + verifier")
hotret(R.x - 0.06, S.x, y0 - 3.55, "6  ID token (ES256)")

# What each side is responsible for.
"the system keeps its own session" italic small shaded muted ljust at (S.x - 0.85, y0 - 4.4)
"Ruscker authenticates; the system authorizes" italic small shaded muted rjust at (R.x + 0.85, y0 - 4.4)
